# Copy to .env on your own machine. Never commit .env.
# Tests: AIDON_MODEL=muse-spark-1.3-contributor (cheap, training use,
# non-sensitive test data only). Submission/demo: muse-spark-1.3.
AIDON_HOME=
AIDON_API_BASE=
AIDON_API_KEY=
AIDON_MODEL=muse-spark-1.3
# 0 = ask at the end of a completed run whether to promote
# episodic memories to LTM. 1 = promote automatically.
AIDON_AUTO_PROMOTE_TO_LTM=0
# Optional: Qdrant server URL. If empty, local mode under
# AIDON_HOME/qdrant is used.
AIDON_QDRANT_URL=
# Embedder, production: google/embeddinggemma-2, 440M
# (text + vision, audio omitted), 768-dim, local, via
# sentence-transformers >= 6.1. HashEmbedder is tests only.
# AIDON_EMBEDDER=hash forces the test embedder.
AIDON_EMBED_MODEL=google/embeddinggemma-2
# Sparse side for hybrid recall: empty = keyword sparse
# (no extra download). Set to prithivida/Splade_PP_en_v1
# for learned SPLADE sparse, via fastembed.
AIDON_SPARSE_MODEL=
# Execution backend: bubblewrap (default, lightweight
# sandbox) or docker (disposable container, build and
# test work). VM is post-hackathon, future only.
AIDON_EXECUTION_BACKEND=bubblewrap
AIDON_DOCKER_IMAGE=python:3.12-slim
AIDON_DOCKER_NETWORK=0
# Old Aidon knobs, carried over, with the old names.
# Budgets: AIDON_BUDGET_TOKENS, or the old
# AIDON_MAX_TOKENS_PER_RUN. Seconds: AIDON_BUDGET_SECONDS,
# or the old AIDON_MAX_WALLCLOCK_MIN (minutes, x60).
# Sandbox: AIDON_SANDBOX_TIMEOUT, or AIDON_MAX_SANDBOX_SECONDS.
# Approval: AIDON_APPROVAL_TIMEOUT, or AIDON_APPROVAL_TIMEOUT_S.
AIDON_MODEL_TIMEOUT_S=120
AIDON_TIMEZONE=America/Vancouver
AIDON_FORGET_HALF_LIFE_DAYS=21.0
AIDON_FORGET_CLEANUP_THRESHOLD=0.02
AIDON_FORGET_GRACE_DAYS=35
# Messaging, old key names, two-way, WhatsApp owner only.
# WhatsApp: permanent System User token, never a dashboard
# token, which expires in 24 hours. Owner number only
# becomes a goal, empty owner means inbound disabled.
# Slack: SLACK_BOT_TOKEN is Slack's own name, unchanged.
# SLACK_SIGNING_SECRET is new, from the Slack app, because
# old Slack was polling, not a webhook, and had no secret.
# AIDON_WHATSAPP_TOKEN=
# AIDON_WHATSAPP_PHONE_ID=
# AIDON_WHATSAPP_VERIFY_TOKEN=
# AIDON_WHATSAPP_APP_SECRET=
# AIDON_WHATSAPP_OWNER=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# Public reachability: the WebUI binds localhost only.
# Meta and Slack need a public HTTPS URL, via a tunnel,
# e.g. cloudflared tunnel --url http://127.0.0.1:8002,
# then point the Meta webhook and Slack Event Subscriptions
# at that URL + /webhook/whatsapp or /webhook/slack.
# Do NOT tunnel the full WebUI unauthenticated, use a
# webhook-only listener in front, as old Aidon did.
