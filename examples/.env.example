# Copy to .env in your AIDON_HOME (default ~/.aidon). Never commit .env.
# Tests: AIDON_MODEL=muse-spark-1.3-contributor (cheap, training use only)
# Submission/demo: muse-spark-1.3
AIDON_HOME=
AIDON_BACKEND=auto

# --- model backend ---
# ollama = local server, no key
# meta = Meta Model API (OpenAI-compatible)
# http = any OpenAI-compatible endpoint
# fake = offline tests only
# Empty infers: a Meta key means meta, an Ollama endpoint means ollama, else fake.
# Dev (home PC, Ollama):
AIDON_API_KEY=
AIDON_MODEL=
# AIDON_OLLAMA_ENDPOINT=http://localhost:11434
# AIDON_OLLAMA_THINK=0
# AIDON_OLLAMA_NUM_CTX=131072
# Fast tier context is separate (a small model has a small window).
# AIDON_FAST_NUM_CTX=16384
# Hackathon: Meta Model API (Muse Spark 1.3)
AIDON_API_ENDPOINT=
AIDON_API_KEY=
AIDON_MODEL=muse-spark-1.3
AIDON_BACKEND=meta
# Image model, same Meta Model API endpoint and key as Spark.
AIDON_IMAGE_MODEL=muse-image-1.0
# SAM 3.1, same Meta endpoint and key as Spark.
AIDON_SAM_MODEL=meta-sam
# Per-request model API timeout (seconds).
AIDON_MODEL_TIMEOUT_S=120
# WebUI token (empty = localhost only, set = Bearer required).
# AIDON_WEBUI_TOKEN=
# Auto-promote episodic memories to LTM on run completion (0/1).
AIDON_AUTO_PROMOTE_TO_LTM=0

# --- two-tier model routing ---
# Empty fast model = single-tier, everything runs on the strong model.
AIDON_FAST_MODEL=
AIDON_ROUTER_FAST_PHASES=interpret,learn,respond
# AIDON_VERIFIER_MODEL=
# Kernel mode: 1 = seed tools only (every other capability earned via the ladder).
# AIDON_KERNEL=0

# --- state & memory ---
AIDON_QDRANT_URL=
AIDON_EMBED_MODEL=google/embeddinggemma-2
# Sparse side for hybrid recall. Empty = keyword sparse (no extra download).
AIDON_SPARSE_MODEL=
# Forgetting curve: deterministic memory decay (zero model cost).
AIDON_FORGET_HALF_LIFE_DAYS=21.0
AIDON_FORGET_CLEANUP_THRESHOLD=0.02
AIDON_FORGET_GRACE_DAYS=35
# Timezone for cron schedules and daily report.
AIDON_TIMEZONE=America/Vancouver

# --- execution (sandbox) ---
# bubblewrap (default, lightweight) or docker (disposable container, build/test work).
AIDON_EXECUTION_BACKEND=bubblewrap
AIDON_DOCKER_IMAGE=python:3.12-slim
AIDON_DOCKER_NETWORK=0
# Sandbox limits.
AIDON_MAX_SANDBOX_SECONDS=120

# --- budgets ---
# Hard per-run limits (a runaway loop must not burn credits).
AIDON_MAX_TOKENS_PER_RUN=200000
AIDON_MAX_WALLCLOCK_MIN=60
AIDON_MAX_STEPS=24
# Consecutive sandbox iterations with no progress before escalation.
AIDON_MAX_STUCK_ITERATIONS=8
# Tool calls executed in parallel per round (1 = serial).
AIDON_PARALLEL_TOOLS=4
# Approval timeout (seconds) before fail-closed.
AIDON_APPROVAL_TIMEOUT_S=180
# Ingest folder: a new or changed file there is a trigger.
# AIDON_INGEST_DIR=

# --- research ---
# Search backend: tavily (needs TAVILY_API_KEY) or searxng.
AIDON_SEARCH_BACKEND=tavily
TAVILY_API_KEY=
AIDON_SEARXNG_URL=
# Research allowlist (comma list, empty = unrestricted).
AIDON_RESEARCH_ALLOWLIST=
AIDON_RESEARCH_MAX_ROUNDS=10
# YouTube Data API v3, search + metadata, not transcripts.
AIDON_YOUTUBE_API_KEY=
# MCP server URL + token (when Aidon serves MCP to another app).
AIDON_MCP_URL=
AIDON_MCP_TOKEN=
# Scheduler, nudges, autonomy.
AIDON_DAILY_REPORT_TIME=
AIDON_APPROVAL_NUDGE_MIN=15
AIDON_APPROVAL_NUDGE_CHANNEL=
AIDON_AUTONOMY_ENABLED=1
AIDON_AUTONOMY_THRESHOLD=5
AIDON_AUTONOMY_DECAY_DAYS=14.0
# Email.
AIDON_OWNER_EMAIL=
AIDON_CORRECTED_SUBJECT=1

# --- messaging (two-way chat) ---
# WhatsApp Cloud API. Owner only (empty owner = inbound disabled).
AIDON_WHATSAPP_TOKEN=
AIDON_WHATSAPP_PHONE_ID=
AIDON_WHATSAPP_VERIFY_TOKEN=
AIDON_WHATSAPP_APP_SECRET=
AIDON_WHATSAPP_OWNER=
# Slack bot token (xoxb-*) for slack_send (2-way channel, no approval).
SLACK_BOT_TOKEN=
# Inbound chat: DM/channel ID(s) to watch (empty = off).
AIDON_SLACK_INBOUND_CHANNEL=
AIDON_SLACK_POLL_SECONDS=10
# Post a temporary acknowledgement when a goal runs longer than this.
AIDON_SLACK_ACK_AFTER_SECONDS=15
# Old Aidon behavior: WebUI starts Slack polling when a channel is set.
# launch.sh --both disables this in the webhook-only process to avoid a
# duplicate poller.
AIDON_SLACK_AUTOSTART=1
# Optional, only for Slack Events API webhook mode. Polling does not need it.
SLACK_SIGNING_SECRET=
# Optional destination-specific Incoming Webhooks. Replace the suffix with
# the real Slack conversation ID, for example C012ABC or D012ABC. These URLs
# are secrets and must never be committed.
# AIDON_SLACK_WEBHOOK_C012ABC=https://hooks.slack.com/services/...
# AIDON_SLACK_WEBHOOK_D012ABC=https://hooks.slack.com/services/...
# Gmail OAuth for send, drafts only without it.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- voice & TTS ---
# Fish Audio S2.1 Pro TTS.
AIDON_FISH_API_KEY=
AIDON_TTS_VOICE_ID=
# Muse Voice Transcribe (Meta Model API), falls back to AIDON_API_KEY.
AIDON_TRANSCRIBE_API_KEY=

# --- social publishing (one-way, approval-gated) ---
AIDON_THREADS_ACCESS_TOKEN=
AIDON_THREADS_ACCOUNT_ID=
AIDON_IG_USER_ID=
AIDON_IG_ACCESS_TOKEN=
# GitHub, optional, raises rate limits.
GITHUB_TOKEN=
