# Copy to .env and edit. Swapping dev <-> hackathon = this file only.

#
# Groups mirror the WebUI settings page. A line starting with # is a
# commented-out setting: uncomment it and fill in a value to use it.
# Values shown are the defaults; change them to tune Aidon.

# --- Model ---
# Which model answers, which backend serves it, and how hard it thinks.

# The endpoint and key are user-specific, so they stay commented until
# you fill them in; the model name defaults to muse-spark.
# AIDON_API_ENDPOINT=  # your model API endpoint, e.g. the Meta Model API base URL

# The endpoint and key are user-specific, so they stay commented until
# you fill them in; the model name defaults to muse-spark.
# AIDON_API_KEY=  # your API key; never commit a real key

# The endpoint and key are user-specific, so they stay commented until
# you fill them in; the model name defaults to muse-spark.
AIDON_MODEL=muse-spark

# Hackathon: Meta Model API (Muse Spark 1.3)
# AIDON_API_ENDPOINT=https://<model-api-endpoint>/v1

# Hackathon: Meta Model API (Muse Spark 1.3)
# AIDON_API_KEY=<your-meta-api-key>

# Hackathon: Meta Model API (Muse Spark 1.3)
# Default: muse-spark.
# AIDON_MODEL=muse-spark

# ...or store the API key ahead of time, then flip AIDON_BACKEND=meta.

# Backend selection: auto | native | meta | http | fake
# auto selects a compatible backend from the endpoint and key.
AIDON_BACKEND=auto

# Server-side chain-of-thought (1 = on, 0 = off) when supported.
# Off = much faster per step, weaker on hard reasoning. The thinking is
# captured and shown in `aidon run --verbose` and the WebUI sidebar.
# Default: 0.
AIDON_MODEL_THINK=0

# Native context window. 0 = server default.
AIDON_MODEL_NUM_CTX=0

# Context window for the fast tier only (0 = server default).
# A small model doesn't need the strong tier's large ctx.
AIDON_FAST_NUM_CTX=0

# Per-request timeout (seconds) for model API calls, both backends.
# Raise for big models / long generations; the hackathon's rate-limited
# API may also stall, and transient failures retry with backoff.
# Default: 120.
AIDON_MODEL_TIMEOUT_S=120

# Which phases get extended reasoning at all (comma-separated; 'all' /
# 'none' work). Reasoning suits prose judgment; it harms phases that
# must emit machine-parseable JSON.
# Default: interpret,verify.
# AIDON_THINK_PHASES=interpret,verify

# Thinking depth: empty = Aidon judges each goal (quick | standard |
# deep — deep when the core work is coding, complex math, or
# unfamiliar territory). Set a value to force every run to it.
# A failed pass raises the effort a level — only when the verifier
# rejected completed work, never for network / I/O / tool failures.
# AIDON_DEPTH=

# Per-phase effort override (a pin is never raised by escalation):
# AIDON_EFFORT_<PHASE>=off|low|medium|high   e.g. AIDON_EFFORT_VERIFY=low

# Master switch for the per-phase sampling overrides below (1 = on, the
# default; 0 = the built-in table only, overrides ignored).
# AIDON_DYNAMIC_SAMPLING=1

# Per-phase sampling overrides (unset = the built-in table: verify
# 0.0, interpret 0.1, research 0.2, plan 0.2, learn 0.3, compact 0.1,
# respond 0.8 with top_p 0.95):
# AIDON_TEMP_<PHASE>=<float>    e.g. AIDON_TEMP_VERIFY=0.0

# Per-phase sampling overrides (unset = the built-in table: verify
# 0.0, interpret 0.1, research 0.2, plan 0.2, learn 0.3, compact 0.1,
# respond 0.8 with top_p 0.95):
# AIDON_TOP_P_<PHASE>=<float>   e.g. AIDON_TOP_P_RESPOND=0.95

# Verify-phase seed (unset = 42; empty = off): deterministic grading
# on backends that honor seeds (best-effort).
# Default: 42.
# AIDON_VERIFY_SEED=42

# Which model tiers can SEE images (comma-separated). The fast tier
# is text-only; sending it images wastes tokens and confuses it.
# Default: strong.
# AIDON_VISION_TIERS=strong

# Name a cheaper/faster model here and Aidon routes cheap phases
# (interpret, skill distillation, trace compaction) to it, keeping hard
# phases (research, plan, execute) on the strong model above. Empty =
# no routing, everything runs on the strong model. Per-tier usage shows
# up in `aidon report autonomy` as router fast/strong calls + tokens.
# AIDON_FAST_MODEL=

# Name a cheaper/faster model here and Aidon routes cheap phases
# (interpret, skill distillation, trace compaction) to it, keeping hard
# phases (research, plan, execute) on the strong model above. Empty =
# no routing, everything runs on the strong model. Per-tier usage shows
# up in `aidon report autonomy` as router fast/strong calls + tokens.
# AIDON_FAST_API_ENDPOINT=  # endpoint for the fast model; empty = main endpoint

# Name a cheaper/faster model here and Aidon routes cheap phases
# (interpret, skill distillation, trace compaction) to it, keeping hard
# phases (research, plan, execute) on the strong model above. Empty =
# no routing, everything runs on the strong model. Per-tier usage shows
# up in `aidon report autonomy` as router fast/strong calls + tokens.
# AIDON_FAST_API_KEY=  # key for the fast endpoint; empty = main key; never commit a real key

# Name a cheaper/faster model here and Aidon routes cheap phases
# (interpret, skill distillation, trace compaction) to it, keeping hard
# phases (research, plan, execute) on the strong model above. Empty =
# no routing, everything runs on the strong model. Per-tier usage shows
# up in `aidon report autonomy` as router fast/strong calls + tokens.
# AIDON_VERIFIER_MODEL=  # independent model for the verify phase

# Comma-separated phases on the fast tier (default: interpret,learn,respond).
# interpret runs on fast but escalates to strong when confidence < 0.7.
# Widen to research,... only if quality holds.
# AIDON_ROUTER_FAST_PHASES=interpret,learn,respond

# Detection + segmentation + video tracking in one call. Billing/auth are
# unified with the Meta Model API. VERIFY the model id against the Meta
# Model API console (default below follows meta-models/meta-sam docs).
# AIDON_SAM_BASE_URL=https://api.meta.ai/v1

# Detection + segmentation + video tracking in one call. Billing/auth are
# unified with the Meta Model API. VERIFY the model id against the Meta
# Model API console (default below follows meta-models/meta-sam docs).
# AIDON_SAM_API_KEY=<redacted>   # empty = fall back to AIDON_API_KEY

# Detection + segmentation + video tracking in one call. Billing/auth are
# unified with the Meta Model API. VERIFY the model id against the Meta
# Model API console (default below follows meta-models/meta-sam docs).
# AIDON_SAM_MODEL=

# Detection + segmentation + video tracking in one call. Billing/auth are
# unified with the Meta Model API. VERIFY the model id against the Meta
# Model API console (default below follows meta-models/meta-sam docs).
AIDON_IMAGE_MODEL=muse-image-1.0

# --- Sandbox ---
# Where shell steps run and what they are allowed to touch.

# Kernel mode (1 = on): only the minimal seed toolset is exposed
# (shell, file read/write, web fetch, the human channel, gated
# installs, MCP connect, plugin adoption) — every other capability
# must be earned via the ladder. 0 = the full built-in toolset.
# Default: 0.
# AIDON_KERNEL=0

# Desktop control is opt-in and requires a live X11 session. The demo
# should run with AIDON_KERNEL=0; leave the driver empty otherwise.
AIDON_COMPUTER_DRIVER=x11

# Desktop control is opt-in and requires a live X11 session. The demo
# should run with AIDON_KERNEL=0; leave the driver empty otherwise.
DISPLAY=:0

# auto = bubblewrap when `bwrap` is on PATH (real isolation), otherwise the
# subprocess fallback (heuristic checks only — NOT a security boundary).
# Default: auto.
# AIDON_SANDBOX_BACKEND=auto

# auto = bubblewrap when `bwrap` is on PATH (real isolation), otherwise the
# subprocess fallback (heuristic checks only — NOT a security boundary).
# Default: auto.
# AIDON_SANDBOX_NETWORK=0   # 1 = allow network inside the sandbox (default: offline)

# auto = bubblewrap when `bwrap` is on PATH (real isolation), otherwise the
# subprocess fallback (heuristic checks only — NOT a security boundary).
# Default: auto.
# AIDON_SANDBOX_REQUIRE_ISOLATION=0  # 1 = fail closed: refuse sandbox commands instead of running unisolated

# auto = bubblewrap when `bwrap` is on PATH (real isolation), otherwise the
# subprocess fallback (heuristic checks only — NOT a security boundary).
# Default: auto.
# AIDON_PATTERNS=on  # 1/on = run a task pattern (write a text of the
#   requested kind / research then write / answer a question) when it fits
#   the goal, instead of planning a new graph; 0/off = always plan.

# auto = bubblewrap when `bwrap` is on PATH (real isolation), otherwise the
# subprocess fallback (heuristic checks only — NOT a security boundary).
# Default: auto.
# AIDON_PATTERNS_FIRST=0  # 1 = a task pattern runs BEFORE the
#   conversational lane, so every text request uses the same machinery
#   (fewer tokens, but the pipeline runs it twice); 0 = the chat lane
#   keeps screen-only asks.

# Resource caps for sandboxed shells (ulimit; 0 = disabled):
# Default: 1024.
# AIDON_SANDBOX_MEM_MB=1024

# Resource caps for sandboxed shells (ulimit; 0 = disabled):
# Default: 1024.
# AIDON_SANDBOX_NPROC=256

# Resource caps for sandboxed shells (ulimit; 0 = disabled):
# Default: 1024.
# AIDON_SANDBOX_FSIZE_MB=512

# Resource caps for sandboxed shells (ulimit; 0 = disabled):
# Default: 1024.
# AIDON_SANDBOX_CPU_S=0

# These settings are specific to the current src/ package layout. Leave
# blank or commented unless the corresponding feature is being used.
# Default: bubblewrap.
AIDON_EXECUTION_BACKEND=bubblewrap

# These settings are specific to the current src/ package layout. Leave
# blank or commented unless the corresponding feature is being used.
# Default: bubblewrap.
AIDON_DOCKER_IMAGE=python:3.12-slim

# These settings are specific to the current src/ package layout. Leave
# blank or commented unless the corresponding feature is being used.
# Default: bubblewrap.
AIDON_DOCKER_NETWORK=0

# Set AIDON_VM_HOST to the VM's hostname or IP and AIDON_EXECUTION_BACKEND=vm
# to run shell steps there instead of the local sandbox. AIDON_VM_USER
# defaults to your login. AIDON_VM_SUDO_PASSWORD is only read when
# AIDON_VM_USE_SUDO=1; put it here by hand, never in chat, never logged.

# Set AIDON_VM_HOST to the VM's hostname or IP and AIDON_EXECUTION_BACKEND=vm
# to run shell steps there instead of the local sandbox. AIDON_VM_USER
# defaults to your login. AIDON_VM_SUDO_PASSWORD is only read when
# AIDON_VM_HOST=

# Set AIDON_VM_HOST to the VM's hostname or IP and AIDON_EXECUTION_BACKEND=vm
# to run shell steps there instead of the local sandbox. AIDON_VM_USER
# defaults to your login. AIDON_VM_SUDO_PASSWORD is only read when
# AIDON_VM_USER=

# Set AIDON_VM_HOST to the VM's hostname or IP and AIDON_EXECUTION_BACKEND=vm
# to run shell steps there instead of the local sandbox. AIDON_VM_USER
# defaults to your login. AIDON_VM_SUDO_PASSWORD is only read when
# AIDON_VM_USE_SUDO=0

# Set AIDON_VM_HOST to the VM's hostname or IP and AIDON_EXECUTION_BACKEND=vm
# to run shell steps there instead of the local sandbox. AIDON_VM_USER
# defaults to your login. AIDON_VM_SUDO_PASSWORD is only read when
# AIDON_VM_SUDO_PASSWORD=

# --- Memory ---
# What Aidon remembers, how it recalls, and how it forgets.

# Background fact extraction after chats and runs (1 on, 0 off)
# Default: 1.
# AIDON_MEMORY_EXTRACT=1

# General-fact (semantic) recall limit for plan prompts (default 3)
# AIDON_SEMANTIC_RECALL_LIMIT=3

# Goal-shape overlap (0-1) for DAG replacement, experience adaptation, and failure matching (default 0.3; lower merges more aggressively)
# AIDON_DAG_SIMILARITY=0.3

# Compact the working trace once it exceeds this many tokens (0 = disabled)
AIDON_TRACE_COMPACT_AT=60000

# Hybrid recall limits per store (one hybrid query each, fused with RRF)
# Default: 1.
AIDON_EPISODE_RECALL_LIMIT=3

# Hybrid recall limits per store (one hybrid query each, fused with RRF)
# Default: 1.
AIDON_KNOWLEDGE_RECALL_LIMIT=3

# Token budget for the fused recall block injected into planning
# Default: 2000.
AIDON_RECALL_MAX_TOKENS=2000

# Per-source caps: one noisy source can't starve the others (trims marked)
# AIDON_RECALL_CAP_EPISODES=700

# Per-source caps: one noisy source can't starve the others (trims marked)
# AIDON_RECALL_CAP_KNOWLEDGE=700

# Per-source caps: one noisy source can't starve the others (trims marked)
# AIDON_RECALL_CAP_SKILLS=500

# Forgetting curve: deterministic memory decay (zero model cost)
# Default: 21.
# AIDON_FORGET_HALF_LIFE_DAYS=21.0

# Forgetting curve: deterministic memory decay (zero model cost)
# Default: 21.
# AIDON_FORGET_CLEANUP_THRESHOLD=0.02

# Forgetting curve: deterministic memory decay (zero model cost)
# Default: 21.
# AIDON_FORGET_GRACE_DAYS=35

# Dense embedding model (FastEmbed).
# Switching models needs a fresh store: delete ~/.aidon/qdrant and re-ingest.
# Default: google/embeddinggemma-2.
AIDON_EMBED_MODEL=google/embeddinggemma-2

# Sparse model for hybrid recall. This restores Aidon's default
# learned sparse model; FastEmbed downloads it on first use. Set this
# explicitly empty to disable learned sparse recall and use keyword
# sparse weights instead.
AIDON_SPARSE_MODEL=prithivida/Splade_PP_en_v1

# Qdrant server URL for shared multi-process access, e.g.
# http://127.0.0.1:6333 (empty = embedded local mode, which allows only
# ONE Aidon process at a time — set this when the WebUI, tick loop, and
# slack listener run concurrently).
# AIDON_QDRANT_URL=

# The Oct 28 snapshot of google/embeddinggemma-2. Pinning stops upstream
# README edits from minting new snapshot directories that look like the
# weights downloading again. Override with another revision hash if needed.
# Default: f9972ac22e696a105c482202646979e33e4b5a1e.
AIDON_EMBEDDING_REVISION=f9972ac22e696a105c482202646979e33e4b5a1e

# --- Research ---
# Web search, page fetch, and multi-agent research.

# Max ReAct tool rounds in the research phase (trivial goals used to burn
# minutes on needless searches before this cap existed)
# Default: 10.
AIDON_RESEARCH_MAX_ROUNDS=10

# Search backend: tavily (primary, needs TAVILY_API_KEY) or searxng.
# Default: tavily.
AIDON_SEARCH_BACKEND=tavily

# Search backend: tavily (primary, needs TAVILY_API_KEY) or searxng.
# Default: tavily.
# TAVILY_API_KEY=

# Search backend: tavily (primary, needs TAVILY_API_KEY) or searxng.
# Default: tavily.
# AIDON_SEARXNG_URL=http://localhost:8888

# YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com):
# enables youtube_learn video SEARCH + metadata. Without it, youtube_learn
# still works on direct video URLs/ids (transcript path only).
# Quota: search = 100 units/call, metadata = 1 unit (10,000 units/day free).
# AIDON_YOUTUBE_API_KEY=

# Plan before research (1 = on): the planner flags unknowns, which
# triggers targeted research + replan. 0 = research-first ordering.
# AIDON_PLAN_FIRST=1

# Parallel research workers when swarm fan-out applies (1 = one worker)
# AIDON_RESEARCH_AGENTS=1

# Multi-agent research: off | auto (only when the goal itself
# enumerates the split) | on (model-decomposed fan-out)
# AIDON_SWARM=off

# Comma-separated hosts fetch_url may reach without a domain-grant
# card. Setting this REPLACES the built-in defaults (wikipedia.org,
# stackoverflow.com, github.com, youtube.com, youtu.be, python.org);
# empty = the defaults. Grants accumulate separately in the home.
# AIDON_RESEARCH_ALLOWLIST=

# Index attached files' extracted text for the search_document tool
# (1 = on; 0 = runs read the files directly instead)
# AIDON_DOC_INDEX=1

# Deep research tool: max search rounds (default 2) and max pages fetched per round (default 5)
# AIDON_DEEP_RESEARCH_ROUNDS=2

# Deep research tool: max search rounds (default 2) and max pages fetched per round (default 5)
# AIDON_DEEP_RESEARCH_SOURCES=5

# Research cache bounds: the cache stores fetched pages on disk and
# search used to read every file on every query. Keep cap: files
# kept (oldest pruned on store, default 500); scan cap: newest
# files a search reads (default 200); match cap: entries a search
# returns (default 100). 0 disables that cap.
AIDON_RESEARCH_CACHE_MAX_FILES=500

# Research cache bounds (see above; scan cap, default 200).
AIDON_RESEARCH_CACHE_MAX_SCAN=200

# Research cache bounds (see above; match cap, default 100).
AIDON_RESEARCH_CACHE_MAX_MATCHES=100

# --- Messaging ---
# Two-way chat (Slack, WhatsApp), publishing (Threads, Instagram), and email.

# Slack inbound: 1 = the WebUI auto-starts the listener when a channel
# is configured (0 = run `aidon slack listen` yourself).
# Default: 1.
# AIDON_SLACK_AUTOSTART=1

# Slack bot token (xoxb-*) for slack_send (2-way channel, no approval).
# SLACK_BOT_TOKEN=

# Slack webhook signing secret. This is only for /webhook/slack; polling
# does not need it. The AIDON_ prefix is required.
# AIDON_SLACK_SIGNING_SECRET=

# Inbound chat: DM/channel ID(s) to watch (comma-separated for several,
# empty = off). In DMs every message becomes a goal; in channels only
# @-mentions of the bot do. Bot token needs im:history (DMs) and/or
# channels:history (channels). Run: aidon slack listen
# AIDON_SLACK_INBOUND_CHANNEL=

# Inbound chat: DM/channel ID(s) to watch (comma-separated for several,
# empty = off). In DMs every message becomes a goal; in channels only
# @-mentions of the bot do. Bot token needs im:history (DMs) and/or
# channels:history (channels). Run: aidon slack listen
# Default: 10.
# AIDON_SLACK_POLL_SECONDS=10

# "Working on it…" ack posts only if a Slack goal runs longer than this
# many seconds (0 = ack immediately, as before).
# Default: 15.
# AIDON_SLACK_ACK_AFTER_SECONDS=15

# Optional destination-specific Incoming Webhooks. Replace the suffix with
# the real Slack conversation ID. These URLs are secrets; never commit them.
# AIDON_SLACK_WEBHOOK_C012ABC=https://hooks.slack.com/services/...

# Optional destination-specific Incoming Webhooks. Replace the suffix with
# the real Slack conversation ID. These URLs are secrets; never commit them.
# AIDON_SLACK_WEBHOOK_D012ABC=https://hooks.slack.com/services/...

# Threads: direct API (preferred, no threads-cli needed) — long-lived token
# with threads_basic + threads_content_publish scopes. Account ID is the
# numeric Threads user ID. Falls back to `threads-cli` when the token is empty.
# AIDON_THREADS_ACCESS_TOKEN=

# Threads account FBID; empty = resolved once via `threads-cli accounts`.
# AIDON_THREADS_ACCOUNT_ID=

# Permanent token: Meta dashboard -> your app -> WhatsApp -> API setup ->
# create a System User with whatsapp_business_messaging, assign the app,
# generate the token (never expires; keep secret).
# AIDON_WHATSAPP_TOKEN=

# Business phone-number ID: same API-setup page ("Phone number ID").
# AIDON_WHATSAPP_PHONE_ID=

# Webhook verify token: any random string you invent (also entered in the
# Meta dashboard webhook config alongside the callback URL).
# AIDON_WHATSAPP_VERIFY_TOKEN=

# App secret: Meta dashboard -> your app -> Settings -> Basic -> App secret
# (click Show). Used for X-Hub-Signature-256 verification of webhooks.
# AIDON_WHATSAPP_APP_SECRET=

# Owner's phone number (e.g. +16045551234): only this sender's messages
# become goals. Empty = inbound disabled.
# AIDON_WHATSAPP_OWNER=

# Webhook callback URL (human setup, one time): your public URL +
# /webhooks/whatsapp — e.g. via `cloudflared tunnel --url http://localhost:8765`
# (the WebUI port). NOTE: tunneling exposes the whole WebUI; /api/goals and
# /api/settings are unauthenticated — prefer Cloudflare Access in front.
# AIVA's WebUI port, then paste into Meta dashboard -> WhatsApp ->
# Configuration -> Webhook -> Edit, subscribe to `messages`.

# IG Business/Creator account linked to a Facebook Page; Meta app with the
# Instagram product; long-lived token with instagram_basic +
# instagram_content_publish. IG user ID: GET /me/accounts -> page ->
# /{page-id}?fields=instagram_business_account
# AIDON_IG_USER_ID=

# IG Business/Creator account linked to a Facebook Page; Meta app with the
# Instagram product; long-lived token with instagram_basic +
# instagram_content_publish. IG user ID: GET /me/accounts -> page ->
# /{page-id}?fields=instagram_business_account
# AIDON_IG_ACCESS_TOKEN=

# Email goes through the Gmail API, not SMTP and not an MCP server.
# Setup (human, one time): grant Gmail API access (OAuth refresh token);
# the account that grants it is the account mail is read from and sent as.
# The OAuth client id, secret, and refresh token live under Extensions
# below (GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN);
# put them in .env by hand, never in chat.
# The human's own address. Mail TO this address needs no send approval
# (he is the one asking and the one receiving); mail to anyone else
# always goes draft -> approval -> send.
# AIDON_OWNER_EMAIL=you@example.com

# Corrected-subject rule (1 = on): re-sending email content that has
# CHANGED since a previous send stamps the subject
# 'Corrected: [YYYY-MM-DD HH:MM] <original subject>' — applied by the
# tool layer from content hashes (sent mail is logged in the home),
# never left to the sender's memory. First sends are never stamped.
# Default: 1.
# AIDON_CORRECTED_SUBJECT=1

# --- Voice ---
# Speech in and out: transcription and text-to-speech.

# Key for Fish TTS.
# AIDON_FISH_API_KEY=

# Optional voice reference_id; empty = default voice.
# AIDON_TTS_VOICE_ID=

# Auto-play TTS for Aidon responses in the WebUI (1 = on)
# Default: 0.
# AIDON_VOICE_ANNOUNCE=0

# Mic button in the WebUI -> POST api.meta.ai/v1/asr/transcribe -> text.
# Empty = fall back to AIDON_API_KEY; empty both = mic shows "not configured".
# AIDON_TRANSCRIBE_API_KEY=<redacted>

# --- WebUI ---
# The browser UI: port, hosts, avatar, and auto-started listeners.

# Scheduler: 1 = the WebUI runs the tick loop in-process (0 = `aidon tick
# --loop` yourself or via the systemd unit; skipped automatically if
# aidon-tick.service is already running).
# AIDON_TICK_AUTOSTART=1

# Port the WebUI listens on (the webhook-only listener takes its own
# --port flag). Restart to change.
# Default: 8765.
# AIDON_WEBUI_PORT=8765

# Extra Host headers the WebUI accepts (comma-separated), e.g. a
# tailnet name. Localhost is always allowed.
# AIDON_WEBUI_ALLOWED_HOSTS=

# DROP-IN: put your VRM file at aidon/webui/avatar.vrm and refresh the page.
# No rebuild, no config edit needed. Or point anywhere on disk instead:
# AIDON_VRM_PATH=/absolute/path/to/your-model.vrm

# --- Loop ---
# Run budgets, retries, critics, choice policy, and approvals.

# Hard token budget for one goal run.
# Default: 200000.
AIDON_MAX_TOKENS_PER_RUN=200000

# Hard token budget for one goal run.
# Default: 200000.
AIDON_MAX_STEPS=50

# Hard token budget for one goal run.
# Default: 200000.
AIDON_MAX_WALLCLOCK_MIN=60

# Hard token budget for one goal run.
# Default: 200000.
AIDON_MAX_SANDBOX_SECONDS=120

# Watchdog: consecutive sandbox iterations with no progress before escalation
# Default: 8.
AIDON_MAX_STUCK_ITERATIONS=8

# Tool calls executed in parallel per round (1 = serial)
# Default: 4.
# AIDON_PARALLEL_TOOLS=4

# DAG/plan steps executed in parallel per level (1 = sequential, default 3)
# AIDON_PARALLEL_WORKERS=3

# Repair attempts per run: execute, verify, repair, up to this many tries (default 3)
# AIDON_MAX_ATTEMPTS=3

# Research-plus-replan passes before execution (default 1, 0 = skip)
# AIDON_MAX_REPLANS=1

# Repair tries when the validator rejects a plan (default 2, 0 = fail immediately)
# AIDON_MAX_PLAN_REPAIRS=2

# ReAct compatibility loop: max rounds (default 8) and parallel tool workers per round (default 3)
# AIDON_REACT_MAX_ROUNDS=8

# ReAct compatibility loop: max rounds (default 8) and parallel tool workers per round (default 3)
# AIDON_REACT_MAX_WORKERS=3

# Plan critic (reflection before execution): 1 = on, 0 = off (default 1); repair rounds per plan (default 1, 0 = advise without repairing)
# AIDON_CRITIC_ENABLED=1

# Plan critic (reflection before execution): 1 = on, 0 = off (default 1); repair rounds per plan (default 1, 0 = advise without repairing)
# AIDON_CRITIC_MAX_ROUNDS=1

# Plan critic (reflection before execution): 1 = on, 0 = off (default 1); repair rounds per plan (default 1, 0 = advise without repairing)
# AIDON_CRITIC_MAX_ISSUES=5

# Plan critic scope: risk (default) reviews only fresh large plans
# and plans with live steps (post/send/publish); adapted and small
# plans skip it, and the skip is traced. always reviews every valid
# plan. Flip to always if risk-based review misses real flaws.
AIDON_CRITIC_MODE=risk

# Small-plan threshold for risk-based critic mode: a plan with at
# most this many steps counts as small and skips review when it has
# no live steps (default 3; 0 means only adapted plans skip).
AIDON_CRITIC_RISK_MAX_STEPS=3

# Agentic runs across all surfaces/processes take a durable FIFO
# execution ticket: one run at a time per Aidon home, held through
# approval waits. Set to 0 to let surfaces run concurrently.
# AIDON_EXECUTION_QUEUE=1

# Minutes a pending approval waits before a Slack nudge (0 = disabled)
# Default: 15.
AIDON_APPROVAL_NUDGE_MIN=15

# Slack channel/DM for approval nudges (empty = no nudges)
# AIDON_APPROVAL_NUDGE_CHANNEL=

# Seconds a pending approval waits before fail-closed timeout
# Default: 900.
# AIDON_APPROVAL_TIMEOUT_S=900

# Graduated approvals: low/medium-stakes classes earn standing permission
# after consecutive explicit approvals (high-stakes never graduates)
# Default: 1.
# AIDON_AUTONOMY_ENABLED=1

# Graduated approvals: low/medium-stakes classes earn standing permission
# after consecutive explicit approvals (high-stakes never graduates)
# Default: 1.
# AIDON_AUTONOMY_THRESHOLD=5

# Graduated approvals: low/medium-stakes classes earn standing permission
# after consecutive explicit approvals (high-stakes never graduates)
# Default: 1.
# AIDON_AUTONOMY_DECAY_DAYS=14.0

# Choice policy when research finds real alternatives: auto (reason and
# pick) or ask (present ranked candidates at a choice gate)
# AIDON_CHOICE_POLICY=auto

# Attention notifications (approvals, escalations, errors, run outcome)
# go to Slack via AIDON_APPROVAL_NUDGE_CHANNEL above (needs SLACK_BOT_TOKEN)

# --- Scheduler ---
# Scheduled work: the daily report and the tick loop.

# Cron for the daily report (empty = disabled)
# AIDON_DAILY_REPORT_TIME=0 9 * * *

# --- State ---
# Where Aidon keeps its home and which timezone it schedules in.

# Aidon home directory: state, memory, scheduler jobs, and plugins live here. Default: ~/.aidon.
# AIDON_HOME=~/.aidon

# Timezone for cron schedules (scheduler, daily report)
# Default: UTC.
# AIDON_TIMEZONE=America/Vancouver

# --- Extensions ---
# Optional integrations: MCP servers, Gmail, GitHub, and the learning-loop governor.

# Optional MCP server URL; empty = off.
# AIDON_MCP_URL=  # optional MCP server URL; empty = off

# Optional MCP server URL; empty = off.
# AIDON_MCP_TOKEN=  # secret token for AIDON_MCP_URL; never commit a real token

# Optional MCP server URL; empty = off.
# GMAIL_CLIENT_ID=  # Gmail OAuth client ID (setup.sh prompts for it)

# Optional MCP server URL; empty = off.
# GMAIL_CLIENT_SECRET=  # Gmail OAuth client secret; never commit a real secret

# Optional MCP server URL; empty = off.
# GMAIL_REFRESH_TOKEN=  # Gmail OAuth refresh token; never commit a real token

# Candidate skills Aidon may mint per UTC day (0 = unlimited)
# Default: 5.
AIDON_LEARN_MAX_SKILLS_PER_DAY=5

# Tokens the self-improvement loop may spend per UTC day (learn phase only)
AIDON_LEARN_MAX_TOKENS_PER_DAY=500000

# Failed uses before a skill auto-retires
# Default: 3.
AIDON_SKILL_MAX_FAILURES=3

# Optional; raises GitHub API rate limits (unauthenticated = 10 req/min)
# GITHUB_TOKEN=<redacted>
