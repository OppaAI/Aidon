# Copy to .env on your own machine. Never commit .env.
# Tests: AIDON_MODEL=muse-spark-1.3-contributor (cheap, training use,
# non-sensitive test data only). Submission/demo: muse-spark-1.3.
AIDON_HOME=
AIDON_API_BASE=
AIDON_API_KEY=
AIDON_MODEL=muse-spark-1.3
# 0 = ask at the end of a completed run whether to promote
# episodic memories to LTM. 1 = promote automatically.
AIDON_AUTO_PROMOTE_TO_LTM=0
# Optional: Qdrant server URL. If empty, local mode under
# AIDON_HOME/qdrant is used.
AIDON_QDRANT_URL=
